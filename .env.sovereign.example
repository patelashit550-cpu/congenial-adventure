# Sovereign deploy — copy keys you need into .env.local (never commit .env.local)
#
# Pinata: app.pinata.cloud → API Keys → New Key (pinFileToIPFS + publishIpns)
PINATA_JWT=

# Dedicated gateway (Gateways page). Use custom domain when wired.
PINATA_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud

# Managed IPNS key name (Pinata → IPNS). Stable pointer; update on each deploy.
PINATA_IPNS_NAME=

# Optional pin label in Pinata dashboard
PINATA_PIN_NAME=transition-insight-out

# Bake into the *next* build after first successful pin (scripts print these):
# NEXT_PUBLIC_IPFS_CID=
# NEXT_PUBLIC_IPFS_GATEWAY=https://YOUR-SUBDOMAIN.mypinata.cloud
# NEXT_PUBLIC_IPNS_NAME=
