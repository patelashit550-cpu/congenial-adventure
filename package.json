{
  "name": "planet-iii-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:local": "node scripts/with-content-tier.mjs local node ./node_modules/next/dist/bin/next dev",
    "dev:global": "node scripts/with-content-tier.mjs global node ./node_modules/next/dist/bin/next dev",
    "dev:preprod": "node scripts/with-content-tier.mjs preprod node ./node_modules/next/dist/bin/next dev",
    "build": "node scripts/sync-published-assets.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "build:global": "node scripts/sync-published-assets.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node scripts/with-content-tier.mjs global node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "build:preprod": "node scripts/sync-published-assets.mjs && node scripts/generate-agent-skills-index.mjs && node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs && node scripts/with-content-tier.mjs preprod node ./node_modules/next/dist/bin/next build && node scripts/generate-sitemap-from-export.mjs && node scripts/verify-sitemap.mjs",
    "build:ipfs": "npm run build:global && node scripts/repair-ipfs-export.cjs",
    "build:ipfs:preprod": "npm run build:preprod && node scripts/repair-ipfs-export.cjs",
    "build:deploy": "bash scripts/build-deploy.sh",
    "pinata:upload:out": "node scripts/pinata-upload-dir.mjs",
    "kubo:install": "bash scripts/install-kubo.sh",
    "arweave:install": "bash scripts/install-arweave-cli.sh",
    "irys:upload:out": "node scripts/irys-upload-out.mjs",
    "ipfs:cid:out": "bash scripts/ipfs-cid-out.sh",
    "start": "next start",
    "lint": "eslint",
    "drafts:save": "node scripts/drafts-save.cjs",
    "content:normalise-drafts": "node scripts/normalise-draft-yaml.cjs",
    "content:publish": "node scripts/publish-drafts.cjs",
    "content:all-draft": "node scripts/set-all-content-stages-to-draft.cjs",
    "content:sign": "node scripts/sign-content.mjs",
    "content:verify": "node scripts/sign-content.mjs --verify",
    "sync:assets": "node scripts/sync-published-assets.mjs",
    "verify:sitemap": "node scripts/verify-sitemap.mjs",
    "verify:sitemap:live": "node scripts/verify-sitemap.mjs --live=https://transition-insight.com",
    "scan:agent-ready": "node scripts/scan-agent-ready.mjs https://transition-insight.com",
    "process:bento-emblems": "python scripts/process-bento-emblems.py",
    "content:attest": "node scripts/generate-attestation.mjs && node scripts/generate-provenance.mjs",
    "deploy:sovereign": "DEPLOY_PINATA=1 DEPLOY_IPNS=1 DEPLOY_DNSLINK=1 bash scripts/build-deploy.sh",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:icons": "npx capacitor-assets generate --android"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.141",
    "@anthropic-ai/sdk": "^0.100.1",
    "@bonfida/sns-react": "^3.1.3",
    "@bonfida/sns-vue": "^1.2.3",
    "@bonfida/spl-name-service": "^0.1.25",
    "@dialectlabs/blinks": "^0.22.5",
    "@dialectlabs/blinks-react-native": "^0.5.0",
    "@ensdomains/content-hash": "^2.5.7",
    "@google/genai": "^2.7.0",
    "@irys/upload": "^0.0.15",
    "@irys/upload-solana": "^0.0.4",
    "@ledgerhq/hw-app-eth": "^6.38.0",
    "@ledgerhq/hw-transport-webhid": "^6.35.2",
    "@microsoft/1ds-core-js": "^3.2.17",
    "@microsoft/1ds-post-js": "^3.2.17",
    "@microsoft/applicationinsights-core-js": "^2.8.18",
    "@microsoft/applicationinsights-shims": "^2.0.2",
    "@microsoft/dynamicproto-js": "^1.1.11",
    "@radix-ui/react-slot": "^1.2.4",
    "@solana/spl-token": "^0.3.11",
    "@solana/web3.js": "^1.98.4",
    "bignumber.js": "^9.3.1",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.8.0",
    "next": "^16.2.6",
    "postcss": "^8.5.11",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.29.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "wrangler": "^4.94.0"
  },
  "overrides": {
    "@ethersproject/providers": {
      "ws": "^8.21.0"
    }
  }
}
